---
import Base from "../layouts/base.astro"
import ArticleList from "../components/article-list.astro";
import AuthorDetails from "../components/author-details.astro";

import "../styles/pages/index.css"

const showSidebar = false;
const recentPostsCount = 5;
---

<Base pageTitle="Home" showSidebar={showSidebar}>
    <div class="home-page">
        <div class="introduction">
            <!-- <h1>Hi, I'm Ben Hollar.</h1> -->
            <AuthorDetails
                name="Hi, I'm Ben Hollar."
                description="Software developer and hobbyist nature photographer."
                photo="ben-transparent-square.png"/>
        </div>
        <hr>
        <div class="recent-posts">
            <h2 class="recent-posts-header">Recent Posts</h2>
            <ArticleList maxCount={recentPostsCount}/>
        </div>
    </div>
</Base>
