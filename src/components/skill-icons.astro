---
import type { SkillIcon } from "../content/skills.astro"
import { allSkills } from "../content/skills.astro"

import "../styles/components/skill-icons.css"

interface Props {
    skills?: SkillIcon[];
}

let { skills } = Astro.props;
skills = skills ?? allSkills;
---

<ul class="skills">
    {skills.map((skill) => (
        <li class="skill">
            <img src={skill.url} alt={skill.text} title={skill.text} />
        </li>
    ))}
</ul>
