---
import { getCollection } from 'astro:content';
import PostPreview from './post-preview.astro';

import "../styles/components/article-list.css";

interface Props {
    maxCount?: number;
}
let { maxCount } = Astro.props;

let posts = await getCollection("blog");
posts.sort((lhs, rhs) => {
    if (lhs.data.date > rhs.data.date) { return -1; }
    if (lhs.data.date < rhs.data.date) { return 1; }
    return 0;
});
if (maxCount != null) {
    posts = posts.slice(0, Math.floor(maxCount));
}
---

<ul class="post-list">
    {posts.map(post => (
        <li class="post-list-item"><PostPreview post={post} /></li>
    ))}
</ul>
